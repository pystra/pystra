{
  "schema_version": 1,
  "baseline_revision": "3c91fb8d0f95c300c84869c47bf5847f291dfed2",
  "scope": "Implemented v2 calibration structure and FORM result contract. Definitions include private helpers for inventory completeness, not public support. Dataclass constructor fields appear under class attributes; generated constructors are not AST definitions.",
  "replacement_workflows": {
    "normalized_code_studies": [
      "pystra.calibration.normalized.NormalizedReliabilityModel",
      "pystra.calibration.normalized.NominalValues",
      "pystra.calibration.normalized.CodeFactors",
      "pystra.calibration.normalized.CodeCalibration.run",
      "pystra.calibration.normalized.CodeCalibrationResult",
      "pystra.calibration.plotting.plot_calibration"
    ],
    "specialist_design_point_factors": [
      "pystra.calibration.factors.FactorCalibrationProblem",
      "pystra.calibration.factors.solve_designs",
      "pystra.calibration.factors.derive_factors",
      "pystra.calibration.factors.select_factors",
      "pystra.calibration.factors.design_with_factors",
      "pystra.calibration.factors.verify_designs"
    ],
    "probabilistic_cases": [
      "pystra.loads.LoadCombination",
      "pystra.loads.VariableRoles",
      "pystra.loads.LoadCombination.from_actions",
      "pystra.loads.LoadCombination.turkstra",
      "pystra.assessment.analyze_case"
    ],
    "form_run": [
      "pystra.reliability.form.FORM.run",
      "pystra.results.FORMResult"
    ]
  },
  "contracts": {
    "exports": "Public calibration records/functions remain available from pystra.calibration; calibration.analyze_case re-exports the shared pystra.assessment function. Calibration has no alias.",
    "form_result": "Frozen snapshot. beta normal-equivalent, design_index signed reference-space distance. design_point_x, design_point_u and alpha are read-only arrays in variable_names order. Iteration exhaustion returns status=not_converged and None estimates with warning; invalid inputs/numerical execution errors raise.",
    "generic_grid": "Finite nonempty 1D ratios in [0,1]. beta is a fresh array (n_dead_load_ratios,n_live_load_ratios); failed points are NaN and retained in cases. to_frame columns: live_load_ratio, dead_load_ratio, design_value, failure_probability, beta, converged, status, message, method, target_margin. Model copied; factors/nominals finite positive.",
    "generic_dependence": "Default independent; explicit copula random-variable order resistance_error,resistance,load_error,dead_load,permanent_load,live_load, omitting constants. Per-run evaluator-specific options, default FORMOptions; DDM unsupported for built-in normalized equation.",
    "specialist_solve": "root (fsolve or bracketed Brent) and alpha. Default beta tolerance=1e-4 and max_evaluations=100 reliability evaluations per case including final verification. Inner convergence, outer success and final residual required. Failures retained; factor derivation rejects them.",
    "specialist_derivation": "coeff/matrix require normal standard space and exactly one leading case per variable action. Explicit names align arrays. Separable resistance-scale equation verified at computed design; arbitrary coupled nonlinear decomposition unsupported. Matrix action coefficient uses its own leading-case inputs, preserving reference convention. Singular systems raise.",
    "factor_results": "Frozen numeric row tuples with case_names/resistance_names/load_names and leading_actions. to_frame(kind) copies. Selection per_case by default; resistance minimum, loads/combinations maximum are explicit. Governing ties retained. Design maximum must be explicitly chosen, then verified.",
    "load_cases": "Constructor validates/copies but does not analyze. Explicit roles cover random variables; leading metadata identifies variable actions by name. Maxima and companions have separate name-to-distribution mappings. Pearson correlation is a uniquely labeled finite symmetric positive-definite DataFrame with unit diagonal. Unknown overrides raise. Case names derive from the case mapping; roles and the limit-state callable are read-only properties so validated metadata cannot be replaced independently. No legacy positional/dictionary constructor.",
    "study_evaluators": "Assessment and calibration default to FORM, with evaluator(model, limit_state, options=options) accepting a method constructor or ReliabilityResult callback. Analyses run on copied inputs. AnalysisError is retained as a failed record; invalid specifications and programming errors raise. Root target solving and verification need normal-equivalent estimates; alpha projection and factor derivation require explicit normal-space design-point capabilities.",
    "study_reporting": "Shared reliability rows include method, status, converged and message. Failed table estimates and target margins are unavailable; original records retain their diagnostics and any under-resolved estimates. TargetDesigns.reliability_frame reports every root solve, including residual and outer solve status."
  },
